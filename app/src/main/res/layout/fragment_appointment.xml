<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/appointmentTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Управление на часове"
            android:layout_marginBottom="12dp"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.applandeo.materialcalendarview.CalendarView
            android:id="@+id/appointmentCalendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:type="one_day_picker"
            app:eventsEnabled="true"
            app:firstDayOfWeek="monday"
            app:anotherMonthsDaysLabelsColor="@color/calendar_other_month_days" />

        <TextView
            android:id="@+id/selectedDateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Избрана дата:"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/weekendMessageTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Почивен ден"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/selectTimeTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Изберете час"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectAllSlotsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Избери всички" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deselectAllSlotsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Премахни избора" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appointmentSlotsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="348dp"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createAppointmentSlotsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Добави час"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeAppointmentSlotButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Премахни час" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>